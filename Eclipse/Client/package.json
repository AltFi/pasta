{
  "name": "pulse-executor-client",
  "version": "1.0.1",
  "description": "PulseExecutor — Lua execution client for Roblox",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "esbuild src/preload/preload.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --outfile=dist/preload/preload.js",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "dependencies": {
    "monaco-editor": "^0.52.2"
  },
  "build": {
    "appId": "com.pulseexecutor.client",
    "productName": "PulseExecutor",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "engine"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "artifactName": "PulseExecutor.exe",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "PulseExecutor.exe"
    },
    "asar": true,
    "compression": "maximum"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}
